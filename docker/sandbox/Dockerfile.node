# AutoResolve Node.js Sandbox Image
# Used for reproducing Node.js/JavaScript issues in isolation

ARG NODE_VERSION=20
FROM node:${NODE_VERSION}-slim

LABEL maintainer="AutoResolve Team"
LABEL description="Isolated Node.js sandbox for bug reproduction"

# Security: Run as non-root user (node user already exists in base image)
# We'll use it later

# Install common development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Install common testing frameworks and tools globally
RUN npm install -g \
    jest@29 \
    mocha@10 \
    chai@4 \
    nyc@15 \
    typescript@5 \
    ts-node@10 \
    eslint@8 \
    prettier@3 \
    npm-check-updates@16

# Set working directory
WORKDIR /code

# Environment configuration
ENV NODE_ENV=test \
    NPM_CONFIG_LOGLEVEL=warn \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

# Security: These are enforced at runtime
# --cap-drop=ALL --read-only --security-opt=no-new-privileges

# Default command: run npm test
CMD ["npm", "test"]

# Health check for container monitoring
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "process.exit(0)"

# Switch to non-root user
USER node
