FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including Docker client
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    docker.io \
    patch \
    && rm -rf /var/lib/apt/lists/*

# Install security scanning tools
RUN pip install --no-cache-dir bandit

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create temp directory for sandbox operations
RUN mkdir -p /tmp/autoresolve && chmod 777 /tmp/autoresolve

# Create non-root user (needs docker group access)
RUN useradd -m -u 1000 -G docker appuser && chown -R appuser:appuser /app

# Default command (override in docker-compose)
CMD ["celery", "-A", "tasks.celery_app", "worker", "--loglevel=info"]
